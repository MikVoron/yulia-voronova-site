server {
    server_name app.voronova.online;

    # Legacy host: preserve every path and query parameter while transferring
    # users and search signals to the canonical plate.voronova.online host.
    return 301 https://plate.voronova.online$request_uri;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control "no-cache" always;

    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/app.voronova.online/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/app.voronova.online/privkey.pem; # managed by Certbot
    # Temporary TSPU compatibility profile: TLS 1.2 only, HTTP/2 stays enabled.
    include /etc/nginx/snippets/options-ssl-nginx-tls12.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    listen 80;
    server_name app.voronova.online;
    return 301 https://plate.voronova.online$request_uri;
}
